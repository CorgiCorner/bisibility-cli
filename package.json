{
  "name": "@bisibility/cli",
  "version": "0.4.2",
  "description": "Command-line client for Bisibility - run rank checks and read ranking history from your terminal.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Corgi Corner",
  "keywords": [
    "api-client",
    "bisibility",
    "cli",
    "command-line",
    "nodejs",
    "rank-tracker",
    "rank-tracking",
    "seo",
    "seo-tools",
    "serp",
    "typescript"
  ],
  "homepage": "https://bisibility.com",
  "bugs": {
    "url": "https://github.com/CorgiCorner/bisibility-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CorgiCorner/bisibility-cli.git"
  },
  "bin": {
    "bisibility": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "LICENSE", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.3 <12",
      "onFail": "error"
    }
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "build": "tsup src/bin.ts src/index.ts --format esm --dts --clean --sourcemap",
    "check": "npm run check:node && npm run lint && npm test && npm run build",
    "check:node": "node tools/check-node.mjs",
    "lint": "biome check . && npm run typecheck",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check",
    "security:dependencies": "npm audit --audit-level=high",
    "test": "vitest run --coverage",
    "sonar:up": "docker compose -f docker-compose.sonar.yml up -d sonarqube",
    "sonar:scan": "docker compose -f docker-compose.sonar.yml run --rm scanner",
    "sonar:check": "npm test && npm run sonar:scan",
    "sonar:down": "docker compose -f docker-compose.sonar.yml down",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@bisibility/sdk": "^0.7.2",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^24.0.3",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "minimatch": "^10.2.5"
  }
}
